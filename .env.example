# ---------------------------------------------------------------------------
# Mollie — betalingen voor het kookboek Spijs.
# Dashboard: https://my.mollie.com -> Developers -> API keys
# Gebruik eerst test_... om te testen, daarna live_... voor productie.
# Mag dezelfde key zijn als bij de tjitzevanderdam.com-site (één Mollie-account
# kan meerdere websites bedienen), of maak een aparte website in Mollie voor
# schonere financiële scheiding.
# ---------------------------------------------------------------------------
MOLLIE_API_KEY=

# ---------------------------------------------------------------------------
# Brevo — transactional e-mail (notificatie + klantbevestiging).
# Hergebruik het bestaande Brevo-account (Culinair AnnoNu BV).
# Eigen API key aanmaken voor deze site is aanbevolen voor traceability:
# Settings -> SMTP & API -> API Keys -> Generate a new API key.
# ---------------------------------------------------------------------------
BREVO_API_KEY=

# Waar de bestel-notificatie heen gaat ("verstuur een boek").
ORDER_NOTIFICATION_EMAIL=hallo@tjitzevanderdam.com

# Afzender van de mails. Domein culinair-annonu.com is reeds geauthenticeerd
# bij Brevo, dus elk @culinair-annonu.com-adres kan als afzender.
ORDER_FROM_EMAIL=Culinair AnnoNu <info@culinair-annonu.com>
